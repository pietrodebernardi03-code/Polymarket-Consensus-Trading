<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.peter.polymarket-paper</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>cd "$HOME/Library/Mobile Documents/com~apple~CloudDocs/Extra Projects/Polymarket Consesus Trading" &amp;&amp; /opt/anaconda3/bin/python3 paper_trader.py &gt;&gt; paper_trader.log 2&gt;&amp;1</string>
    </array>

    <!-- Run every day at 09:00. If the Mac is asleep then, it runs on next wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
